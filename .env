# Configuración del modelo
MODEL_NAME=granite3.2:latest
OLLAMA_API_URL=http://127.0.0.1:11434/api/generate

# Rutas de archivos
DATA_FILE=data/tweets_valencia.json

# Nombres base para archivos de salida (sin extensión)
CACHE_FILE_BASE=categorized_tweets
LOG_FILE_BASE=tweet_analysis

# Directorios de salida
LOGS_DIR=logs
CACHE_DIR=categorized_tweets
REPORTS_DIR=final_reports

# Configuración de logging
LOG_LEVEL=INFO

# Configuración de extracción de categorías
CATEGORY_SAMPLE_SIZE=200 # Número de tweets aleatorios a usar
MIN_CATEGORIES=5       # Mínimo de categorías a generar
MAX_CATEGORIES=8       # Máximo de categorías a generar

# Configuración de rendimiento
BATCH_SIZE=10